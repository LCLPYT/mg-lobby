{
  "schemaVersion": 1,
  "id": "mg-lobby",
  "version": "${version}",
  "name": "Mini Game Lobby",
  "description": "A mod that introduces a game lifecycle along with a waiting lobby",
  "authors": [
    "LCLP",
    "bops"
  ],
  "contact": {
    "homepage": "https://github.com/LCLPYT/mg-lobby",
    "sources": "https://github.com/LCLPYT/mg-lobby"
  },
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "server": [
      "work.lclpnet.lobby.LobbyMod"
    ]
  },
  "mixins": [
    "mg-lobby.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~1.21.5",
    "java": ">=21",
    "fabric-api": "*",
    "kibu": "*",
    "kibu-world-api": "*"
  },
  "suggests": {
    "pal": "*",
    "mcserver-api": "*"
  }
}